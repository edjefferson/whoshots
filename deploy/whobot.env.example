# Copy to whobot.env next to whobot.py and chmod 600 it.
BSKY_HANDLE=yourbot.bsky.social
# Settings > Privacy and security > App passwords on Bluesky.
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Where the images are: a local folder...
IMAGES_DIR=/mnt/hd/whobot/output
# ...or the web address they're served from (used instead of IMAGES_DIR if set).
#IMAGES_URL=https://example.com/whoshots/

#DB_PATH=/mnt/hd/whobot/whobot.db

# Templates: {programme} {series} {episode} {title} {text} {timestamp} {path}, \n for a new line.
POST_TEXT=
ALT_TEXT={text}\n\nDoctor Who, {title} ({series})
